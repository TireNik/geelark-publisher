# Copy this file to .env on the server and replace the placeholder values.
# Never commit the real .env file.
DJANGO_SECRET_KEY=replace-with-a-long-random-django-secret
GEELARK_TOKEN=replace-with-your-geelark-token
# Change the proxy port only after a future GeeLark "Proxy detection failed" (29996).
# The failed publication is never retried automatically.
GEELARK_PROXY_AUTO_ROTATE=0
GEELARK_PROXY_PORT_MIN=10000
GEELARK_PROXY_PORT_MAX=10999
GEELARK_PROXY_ROTATE_ATTEMPTS=3
GEELARK_TASK_TIMEOUT_MINUTES=8
# Video Farm ingest: same token as VF GEELARK_INGEST_TOKEN
VF_SHARELINK_URL=https://ozon-panel.ru/video-farm/api/public/publish/share-link
VF_SHARELINK_TOKEN=
# Incoming JSON POST /api/ingest/ and token-only POST /api/ingest/test/ (empty → VF_SHARELINK_TOKEN)
VF_INGEST_TOKEN=
# Optional: parallel prepare/publish + hang protection
# GEELARK_MAX_PARALLEL=3
# GEELARK_UPLOAD_TIMEOUT_SEC=180
# GEELARK_DOWNLOAD_TIMEOUT_SEC=180
# GEELARK_TASK_SLA_SEC=900
GEELARK_DISPATCH_LEAD_SECONDS=120

